NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://127.0.0.1:27017/syncwave
JWT_SECRET=change-me-to-a-long-random-string

# Google OAuth (optional - the Google button shows an error if unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Frontend origin(s), comma-separated. Used for CORS and OAuth / reset-email links.
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=

# SMTP for password-reset emails (optional in development: if unset,
# the reset link is printed to the server console and shown on the page)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=SyncWave <no-reply@syncwave.app>
